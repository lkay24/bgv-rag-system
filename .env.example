# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/bgv

# https://console.groq.com
GROQ_API_KEY=

# Google Cloud console -> APIs & Services -> Credentials (OAuth client, "Web application").
# Add GOOGLE_REDIRECT_URI below as an authorised redirect URI. Enable the Gmail and Drive APIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional (defaults shown)
# BACKEND_URL=http://localhost:8000
# FRONTEND_URL=http://localhost:8000          # where users are sent after Google login
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback
# CORS_ORIGINS=http://localhost:5500          # extra origins if you serve the UI elsewhere
# MAX_UPLOAD_MB=10
